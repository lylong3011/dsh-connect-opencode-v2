{
  "name": "dsh-connect-opencode-v2",
  "displayName": "DSH Connect OpenCode (v2 native)",
  "description": "Expose the free models of your local OpenCode install to the DeepSeek Harness model picker. Native OpenCode v2 (/api/*) support with automatic v1 compatibility; no wrapper executable and no v1-to-v2 translation shim required.",
  "version": "1.0.1",
  "author": "lylong3011",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "opencode", "model-provider", "free"],
  "type": "module",
  "main": "lib/index.js",
  "bin": { "dsh-connect-opencode-v2": "bin/cli.js" },
  "icon": "icons/icon-128.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lylong3011/dsh-connect-opencode-v2.git"
  },
  "homepage": "https://github.com/lylong3011/dsh-connect-opencode-v2#readme",
  "bugs": {
    "url": "https://github.com/lylong3011/dsh-connect-opencode-v2/issues"
  },
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "bin", "icons", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "test": "node --test test/catalog.test.js"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.88.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
